{
  "name": "staragent-desktop",
  "private": true,
  "version": "0.1.3-dev.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build",
    "check": "vite build",
    "tauri": "tauri",
    "runtime:build": "python scripts/build_runtime.py",
    "runtime:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-runtime.ps1",
    "desktop:dev": "npm run runtime:build && tauri dev --config src-tauri/tauri.sidecar.conf.json",
    "desktop:build": "npm run runtime:build && tauri build --config src-tauri/tauri.sidecar.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "vite": "^6.4.3"
  }
}
